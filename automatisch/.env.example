# Copy to .env and fill in real values before running `docker compose up`.
# Never commit the real .env file.

APP_ENV=production
HOST=localhost
PROTOCOL=http
PORT=3000

# Generate with: openssl rand -base64 36
# Changing these after go-live breaks existing connections/flows — back them up.
ENCRYPTION_KEY=
WEBHOOK_SECRET_KEY=
APP_SECRET_KEY=

POSTGRES_DATABASE=automatisch
POSTGRES_USERNAME=automatisch_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
POSTGRES_ENABLE_SSL=false

REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
